# Copy to server/.env and adjust
MONGO_URI=mongodb://127.0.0.1:27017/tovim
PORT=3000
# Comma-separated browser origins allowed by CORS (default: the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Max JSON body size; singles carry base64 images
JSON_BODY_LIMIT=10mb
# Path to the built client (e.g. ../client/dist). When set, the server also
# serves the web app and the API moves under /api (used by render.yaml)
# CLIENT_DIST=../client/dist
# Set to true to load the demo data on start when it isn't there yet
# SEED_DEMO=true
